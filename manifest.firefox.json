{
  "manifest_version": 3,
  "name": "Hitomi Web",
  "version": "1.1.0",
  "description": "우클릭 메뉴의 주소와 페이지에서 감지한 영상을 Hitomi Web 서버에 등록합니다. 설정에서 X·YouTube·네이버 로그인 쿠키를 올릴 수 있습니다.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "cookies",
    "notifications",
    "alarms",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "detect.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Hitomi Web · 감지한 영상",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hitomi-web@lemminol.xyz",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity",
          "websiteContent"
        ]
      },
      "update_url": "https://github.com/lemminol/hitomi-web-extension/releases/latest/download/updates.json"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
